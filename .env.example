# ──────────────────────────────────────────────────────────────────────────────
# API Test Tool — environment configuration
# Env vars set the DEFAULTS. Changes made in the dashboard override them and are
# stored in the database; "Reset to env defaults" removes those overrides.
# Settings marked (restart) can only be changed here and need a restart.
# Copy to .env for local runs (src/server.js loads it; real env vars win).
# ──────────────────────────────────────────────────────────────────────────────

# ---- Server ------------------------------------------------------------------
# (restart) HTTP port
PORT=3000
# Public base URL used in Location headers, links, OpenAPI servers and presigned URLs.
# Blank = auto-detect: Codespaces -> Fly (FLY_APP_NAME) -> Render (RENDER_EXTERNAL_URL) -> request headers.
PUBLIC_BASE_URL=
# (restart) Protects /dashboard and /admin/api/*. Leave blank only for local use — a warning is logged.
ADMIN_PASSWORD=
# debug | info | warn | error
LOG_LEVEL=info
# Comma list of allowed CORS origins, or *
CORS_ORIGINS=*

# ---- Storage -----------------------------------------------------------------
# (restart) sqlite | postgres
DB_DRIVER=sqlite
# (restart) SQLite file (use a volume in containers, e.g. /data/app.db)
SQLITE_PATH=./data/app.db
# (restart) Postgres / Neon connection string, used when DB_DRIVER=postgres
DATABASE_URL=
# (restart) local | s3
FILE_STORE=local
# (restart) Directory for the local file pool
FILE_DIR=./data/files
# (restart) S3-compatible storage (AWS S3, Cloudflare R2, Fly Tigris, MinIO...) when FILE_STORE=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Object key prefix inside the bucket (lets several instances share one bucket)
S3_PREFIX=files/
# Max upload size in MB (413 problem+json above it)
MAX_FILE_SIZE_MB=100

# ---- Seed data ---------------------------------------------------------------
# always | if-empty | never
SEED_ON_START=if-empty
SEED_EMPLOYEES=250
SEED_PRODUCTS=500
# Same seed => same data (deterministic Faker)
SEED_RANDOM_SEED=42
# Generate CSV/XLSX/JSON/PNG/JPG/PDF/TXT/ZIP and a 10 MB binary on seed
SEED_SAMPLE_FILES=true

# ---- Dates -------------------------------------------------------------------
# Global timestamp format: iso | iso-offset | epoch-s | epoch-ms | rfc1123 | custom
DATE_FORMAT=iso
# dayjs tokens, used when DATE_FORMAT=custom
DATE_FORMAT_PATTERN=YYYY-MM-DD HH:mm:ss
# Offset used by iso-offset and custom
DATE_TZ_OFFSET=+00:00

# ---- Auth for /v1/* ----------------------------------------------------------
# none | apikey | basic | bearer | jwt | oauth2 | hmac
AUTH_MODE=none
API_KEY=demo-key
API_KEY_NAME=X-API-Key
# header | query
API_KEY_IN=header
BASIC_USER=demo
BASIC_PASS=demo
BEARER_TOKEN=demo-token
# RS256 | HS256
JWT_ALG=RS256
# HS256 secret (blank = generated once and stored in the DB)
JWT_SECRET=
# RS256 private key PEM (blank = generated once and stored in the DB). \n escapes are accepted.
JWT_PRIVATE_KEY=
# Blank = the public base URL
JWT_ISSUER=
JWT_AUDIENCE=api-test-tool
HMAC_KEY_ID=demo
HMAC_SECRET=demo-hmac
HMAC_MAX_SKEW_SECONDS=300

# ---- Built-in OAuth 2.0 server -----------------------------------------------
# Semicolon-separated id:secret:scopes (more clients can be added in the dashboard)
OAUTH_CLIENTS=demo-client:demo-secret:read write
# user:password;... for the authorization_code login page
OAUTH_USERS=demo:demo
OAUTH_TOKEN_TTL=3600
OAUTH_REFRESH_TTL=86400

# ---- Chaos (/v1/*) -----------------------------------------------------------
# Percentage of requests that get an injected error
ERROR_RATE=0
# Comma list: any 4xx/5xx status and/or timeout, reset, malformed-json, truncated-body,
# empty-body, wrong-content-type, slow-drip
ERROR_TYPES=500,503
LATENCY_MIN_MS=0
LATENCY_MAX_MS=0
# "timeout" hangs this long then drops the socket (0 = until the client gives up, max 600)
CHAOS_TIMEOUT_SECONDS=0
# Delay between chunks for slow-drip
CHAOS_SLOW_DRIP_MS=250
# JSON list of per-route overrides, e.g. [{"path":"/v1/products","errorRate":50,"errorTypes":"503"}]
CHAOS_ROUTE_OVERRIDES=

# ---- Rate limiting -----------------------------------------------------------
# Requests per minute per client (0 = off). Emits RateLimit-* headers and 429 + Retry-After.
RATE_LIMIT_RPM=0

# ---- Custom headers ----------------------------------------------------------
# Added to every response: Name:Value;Name2:Value2
RESPONSE_HEADERS=
# Required on /v1/* and SOAP requests (400 if missing or wrong): Name,Name2=expected
REQUIRED_HEADERS=

# ---- SOAP (/soap) ------------------------------------------------------------
# Mock SOAP 1.1/1.2 services (EmployeeService, ProductService) over the same data; WSDL at /soap/{Service}?wsdl.
# Requests use AUTH_MODE, chaos, rate limiting and REQUIRED_HEADERS like /v1; errors are SOAP faults.
SOAP_ENABLED=true
# WS-Security UsernameToken: off | optional | required. Uses BASIC_USER / BASIC_PASS (PasswordText or
# PasswordDigest; Created must be within HMAC_MAX_SKEW_SECONDS). Independent of AUTH_MODE.
SOAP_WSSE=off
# SOAPAction / SOAP 1.2 action check: lenient (wrong = fault, missing = ok) | strict (must be right) | off
SOAP_ACTION_CHECK=lenient

# ---- WebSocket (/ws) ----------------------------------------------------------
# Mock channels: /ws/echo, /ws/rpc (JSON-RPC 2.0 over the data), /ws/changes (live change feed).
# The upgrade request uses AUTH_MODE (plus ?access_token= for bearer/jwt/oauth2), rate limiting,
# REQUIRED_HEADERS and chaos like /v1. AsyncAPI 3.0 at /ws/asyncapi.json.
WS_ENABLED=true
# Larger messages close the connection with 1009
WS_MAX_MESSAGE_KB=1024
# Close connections that send nothing for this long (0 = never)
WS_IDLE_TIMEOUT_SECONDS=0
# Server keep-alive pings; a connection that misses a pong is dropped (0 = off)
WS_PING_INTERVAL_SECONDS=30

# ---- OData v4 (/odata/v4) -----------------------------------------------------
# Service document and $metadata are open; everything else uses AUTH_MODE, rate limiting, REQUIRED_HEADERS and chaos.
ODATA_ENABLED=true
# Server-driven page size (longer results get @odata.nextLink), 1-1000
ODATA_MAX_PAGE_SIZE=100

# ---- S3-compatible API (the file pool as a bucket) --------------------------------
# Clients use: endpoint = the base URL, path-style addressing, these keys and region, bucket S3_API_BUCKET.
# Requests are signed with AWS Signature V4 (AUTH_MODE does not apply); rate limiting, REQUIRED_HEADERS and chaos do.
# These are the credentials S3 *clients* use, not the S3_* settings above that choose where the tool stores files.
S3_API_ENABLED=true
S3_API_BUCKET=files
S3_API_REGION=us-east-1
S3_API_ACCESS_KEY_ID=demo-access-key
S3_API_SECRET_ACCESS_KEY=demo-secret-key

# ---- GraphQL (/graphql) -------------------------------------------------------
# Queries, mutations and subscriptions (graphql-transport-ws) over the mock data.
# Uses AUTH_MODE, rate limiting, REQUIRED_HEADERS and chaos; the SDL at /graphql/schema.graphql is open.
GRAPHQL_ENABLED=true
# Allow __schema / __type introspection queries
GRAPHQL_INTROSPECTION=true
# Reject operations nested deeper than this (0 = no limit)
GRAPHQL_MAX_DEPTH=10

# ---- Server-Sent Events (/sse) ------------------------------------------------
# /sse/changes (change feed, Last-Event-ID replay), /sse/ticks, POST /sse/stream (LLM-style).
# Uses AUTH_MODE (plus ?access_token= for bearer/jwt/oauth2), rate limiting, REQUIRED_HEADERS and chaos.
SSE_ENABLED=true
# Comment heartbeat interval (0 = off)
SSE_HEARTBEAT_SECONDS=15
# retry: value sent at the start of every stream
SSE_RETRY_MS=3000
# Change events kept for Last-Event-ID resume
SSE_REPLAY_BUFFER=500
# Default /sse/ticks interval
SSE_TICK_INTERVAL_MS=1000

# ---- Outgoing webhooks -------------------------------------------------------
# Webhooks themselves are defined on the dashboard's Webhooks page (or /admin/api/webhooks) and stored in the database.
# Send them at all (false pauses every webhook; definitions are kept)
WEBHOOKS_ENABLED=true
# How long a delivery waits for the receiver (ms)
WEBHOOK_TIMEOUT_MS=10000
# Deliveries kept in the log (all webhooks together)
WEBHOOK_DELIVERY_RETENTION=200

# ---- Inspector ---------------------------------------------------------------
# Captured requests kept
INSPECTOR_RETENTION=500
# Also record /v1, /soap, /ws, /sse, /graphql, /odata, S3 API and /oauth calls (dashboard, docs and health probes are never recorded)
INSPECTOR_LOG_ALL=true
# Default catch-all response (blank body = JSON receipt with the capture id)
INSPECTOR_RESPONSE_STATUS=200
INSPECTOR_RESPONSE_CONTENT_TYPE=application/json
INSPECTOR_RESPONSE_BODY=
# Name:Value;Name2:Value2
INSPECTOR_RESPONSE_HEADERS=
INSPECTOR_RESPONSE_DELAY_MS=0
# JSON list of path rules, first match wins:
# [{"method":"POST","path":"/hooks/{name}","status":202,"body":{"ok":true,"hook":"{{params.name}}"}}]
INSPECTOR_RULES=
# Auto-forward every capture (the original path is appended to the URL)
INSPECTOR_FORWARD_ENABLED=false
INSPECTOR_FORWARD_URL=
