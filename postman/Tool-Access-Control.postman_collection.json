{
  "info": {
    "_postman_id": "b1f0d7c8-tool-access-control",
    "name": "API Test Tool — Tool access control (MCP)",
    "description": "Which agent can call which MCP tool: the /p/tool-acl profile (jwt auth, 4 tools, MCP_TOOL_ACL on) and three agents whose OAuth scopes are their grants. Every MCP request needs mcp:access; each tools/call needs tool:<name>. Requests carry their own credentials, independent of {{authMode}}. Set {{rootUrl}} to the server (no /p/…) and {{adminPassword}} to ADMIN_PASSWORD (blank when none). Generated by scripts/build-postman.js.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "att-007b",
      "name": "Set up the demo (admin API)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{rootUrl}}/admin/api/tool-acl/demo",
          "host": [
            "{{rootUrl}}/admin/api/tool-acl/demo"
          ]
        },
        "description": "Creates (or resets) the /p/tool-acl profile and the agents alice-agent (admin), bob-agent (developer) and carol-agent (suspended), and stores their secrets. Needs the admin API (401 when ADMIN_PASSWORD is set and not given: the rest of the folder is then skipped).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enabled\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('rootUrl', (pm.environment.get('rootUrl') || pm.environment.get('baseUrl')).replace(/\\/p\\/[^/]+\\/?$/, '').replace(/\\/$/, ''));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, or 401 when the admin API needs a password', () => pm.expect([200, 401]).to.include(pm.response.code));",
              "pm.environment.set('aclReady', pm.response.code === 200 ? 'yes' : 'no');",
              "if (pm.response.code === 200) { const d = pm.response.json(); pm.test('on, 3 agents, 4 tools', () => { pm.expect(d.enabled).to.eql(true); pm.expect(d.agents.length).to.eql(3); pm.expect(d.tools.length).to.eql(4); }); for (const a of d.agents) pm.environment.set(a.clientId.replace('-agent', '') + 'Secret', a.secret); }"
            ]
          }
        }
      ]
    },
    {
      "id": "att-007c",
      "name": "Token for alice-agent (client_credentials)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{rootUrl}}/oauth/token",
          "host": [
            "{{rootUrl}}/oauth/token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            }
          ]
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "alice-agent"
            },
            {
              "key": "password",
              "value": "{{aliceSecret}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get('aclReady') !== 'yes') pm.execution.skipRequest();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const t = pm.response.json();",
              "pm.test('scope is the grants', () => pm.expect(t.scope).to.be.a('string'));",
              "pm.environment.set('aliceToken', t.access_token);"
            ]
          }
        }
      ]
    },
